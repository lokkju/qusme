// The qus.me service on Cloudflare Workers.
//
// lokkju/infra's Pulumi stack owns this Worker's custom domains (app.qus.me for the service, qus.me
// for the landing site), its D1 database and its secrets; this file owns the code. Never declare
// routes, custom domains or a workers.dev route here: the hostnames are attached by Pulumi, and a
// route declared here would fight them. src/index.ts routes by Host between the two.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qusme",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "send_metrics": false,
  "preview_urls": false,
  // Replaced at deploy time with the commit (deploy.yml passes --define).
  "define": {
    "__QUSME_VERSION__": "\"dev\""
  },
  // The origin clients sign NIP-98 requests for (the u tag). Not a secret.
  "vars": {
    "QUSME_PUBLIC_ORIGIN": "https://app.qus.me",
    // The landing site's origin. Requests for this host get site/ (www. in front of it redirects
    // here); requests for QUSME_PUBLIC_ORIGIN's host get the service; any other host gets a 404.
    "QUSME_SITE_ORIGIN": "https://qus.me",
    // The most create_draft calls the whole service accepts per UTC day (spec 8.5, "Limits"), so
    // a bug or abuse cannot pass a known cost. A whole number; 0 refuses every draft.
    "QUSME_DAILY_DRAFT_CEILING": "2000",
    // The most NIP-13 proof of work create_draft mines for a grant's min_pow, in bits (spec 7.4).
    // Sized to the Workers Free plan's 10 ms of CPU per request: 5 bits of a short value take
    // about 1 ms under workerd, 8 bits the whole 10 ms. Each bit doubles the work; raise it only
    // with the plan's CPU limit. A whole number from 0 to 256; 0 refuses any grant with min_pow.
    "QUSME_MAX_POW": "5"
  },
  // Workers Rate Limiting (spec 8.5, "Limits"): one binding per rate class in
  // packages/core/src/limits.ts (RATE_CLASSES), with the same limit and period; a test holds the
  // two together. Counts are per Cloudflare location and approximate, which is enough for abuse
  // limits; the hard caps that bound cost are counted in D1. namespace_id is ours to pick, unique
  // in the account; no Cloudflare resource is created ahead of the deploy.
  "ratelimits": [
    // GET /authorize, per client IP
    { "name": "RL_IP_AUTHORIZE", "namespace_id": "7701", "simple": { "limit": 10, "period": 60 } },
    // GET /authorize/:id and its status poll, per client IP
    { "name": "RL_IP_POLL", "namespace_id": "7702", "simple": { "limit": 60, "period": 60 } },
    // POST /token and POST /revoke, per client IP
    { "name": "RL_IP_TOKEN", "namespace_id": "7703", "simple": { "limit": 20, "period": 60 } },
    // GET /pair/:code, per client IP
    { "name": "RL_IP_PAIR", "namespace_id": "7704", "simple": { "limit": 10, "period": 60 } },
    // /mcp, per agent key (free tier)
    {
      "name": "RL_MCP_AGENT_FREE",
      "namespace_id": "7705",
      "simple": { "limit": 30, "period": 60 }
    },
    // /mcp, per queue (free tier)
    {
      "name": "RL_MCP_QUEUE_FREE",
      "namespace_id": "7706",
      "simple": { "limit": 60, "period": 60 }
    },
    // NIP-98 device routes and POST /pair, per queue key (free tier)
    {
      "name": "RL_DEVICE_QUEUE_FREE",
      "namespace_id": "7707",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // The landing site (site/ at the repo root), served through the ASSETS binding. `main` stays:
  // an assets-only deploy uploads a version with no bindings and drops the Worker's secrets.
  // run_worker_first sends every request through src/index.ts, which serves assets only on the
  // site's host, so app.qus.me never answers with a landing page.
  "assets": {
    "directory": "../../site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qusme",
      // Committed rather than substituted in CI: a D1 id is not a credential, and having it here
      // lets wrangler dev, dry runs and migrations run anywhere without extra setup.
      "database_id": "0e98b101-327b-4bf3-9fc5-f4136b42c235",
      "migrations_dir": "../store-sql/migrations"
    }
  ],
  // Sweeps expired service state (the scheduled handler in src/index.ts). Reads filter on
  // expires_at regardless, so the interval bounds only how long dead rows take up space.
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
  // Secrets, set by Pulumi and kept across deploys: QUSME_AGENT_KEY_SECRET (standard base64 of
  // 32 bytes), and during a rotation QUSME_AGENT_KEY_VERSION and QUSME_AGENT_KEY_SECRET_PREVIOUS.
}
