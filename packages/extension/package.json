{
  "name": "@qusme/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "typecheck": "tsc -p .",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "@qusme/nostr": "workspace:*",
    "nostr-tools": "2.25.2",
    "preact": "11.0.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@modelcontextprotocol/client": "2.4.0",
    "@preact/preset-vite": "2.10.6",
    "@qusme/core": "workspace:*",
    "@qusme/store-sql": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "preact-render-to-string": "6.8.1",
    "tailwindcss": "4.3.3",
    "wxt": "0.21.5"
  }
}
