{
  "name": "@qusme/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wxt prepare",
    "typecheck": "tsc -p .",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@qusme/nostr": "workspace:*"
  },
  "devDependencies": {
    "wxt": "0.21.5"
  }
}
